{
  "name": "@yilinxiao/dsh-mcp-lazy",
  "version": "0.4.0",
  "description": "Lazy MCP bridge for DeepSeek Harness that loads tools on demand to reduce tool-catalog context tokens while keeping connections warm for reuse. · DSH 按需 MCP 桥接：按需加载工具以减少工具目录占用的上下文 Token，并保温连接以便复用。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leaforbook/dsh-mcp-lazy.git"
  },
  "homepage": "https://github.com/leaforbook/dsh-mcp-lazy#readme",
  "bugs": {
    "url": "https://github.com/leaforbook/dsh-mcp-lazy/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "lazy-loading"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
